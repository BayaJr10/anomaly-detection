# ---- Reproducible pipeline image: ingest + train from scratch ----------------------
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 AIRQ_ROOT=/app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps .
COPY configs ./configs
COPY scripts ./scripts
# data/, models/ and reports/ are bind-mounted by docker-compose so results land on the host
ENTRYPOINT ["python", "-m", "airq.pipeline"]
CMD ["train"]
